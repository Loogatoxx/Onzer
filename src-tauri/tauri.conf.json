{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onzer",
  "version": "0.1.0",
  "identifier": "com.loogatoxx.onzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onzer",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#08080A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Music",
    "shortDescription": "Lecteur musical local",
    "longDescription": "Onzer est un lecteur musical 100% hors-ligne, avec moteur de recommandation et statistiques generes entierement en local.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "Onzer"
}
